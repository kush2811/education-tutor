# ==============================================================================
# AI-Powered Multimodal Student Tutor - Production Environment Variables
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="AI-Powered Multimodal Student Tutor"
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Server Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WEB_CONCURRENCY=4

# Production CORS Whitelist (comma-separated origins)
CORS_ORIGINS=https://tutor.yourdomain.com,https://app.yourdomain.com

# Production PostgreSQL Database Connection String
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://tutor_admin:change_this_postgres_password@postgres:5432/ai_tutor_prod
POSTGRES_USER=tutor_admin
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=ai_tutor_prod

# Persistent File Storage Paths (Mounted Volumes)
UPLOAD_DIR=/app/storage/uploads
VECTOR_STORE_DIR=/app/storage/vector_store
LOG_FILE_PATH=/app/storage/logs/tutor.log
ENABLE_FILE_LOGGING=True

# Authentication & Security
# Generate a cryptographically secure 256-bit key via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-character-cryptographically-secure-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# API Rate Limiting
ENABLE_RATE_LIMITER=True
RATE_LIMIT_PER_MINUTE=120

# AI Foundation Model Credentials
GEMINI_API_KEY=your_production_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Speech & Symbolic Verification
TTS_PROVIDER=edge-tts
STT_PROVIDER=whisper-local
ENABLE_SYMPY_VERIFICATION=True

# Production Error Monitoring (Sentry DSN)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

