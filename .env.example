# ==========================================
# AI-Powered Multimodal Student Tutor & Problem Solver
# Master Environment Configuration Template
# ==========================================

# --- General Environment ---
PROJECT_NAME="AI Multimodal Tutor"
ENVIRONMENT="development" # development | staging | production
DEBUG=True
API_V1_PREFIX="/api/v1"

# --- Backend Server Configuration ---
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Database & Storage ---
DATABASE_URL="sqlite:///./tutor.db"
UPLOAD_DIR="./storage/uploads"
VECTOR_STORE_DIR="./storage/vector_store"

# --- Multimodal AI Providers ---
# Primary Vision & LLM Provider (Google Gemini API recommended for multimodal student tutoring)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional Secondary/Alternative LLMs
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Voice / Audio Services ---
TTS_PROVIDER="edge-tts" # edge-tts | web-speech | gtts
STT_PROVIDER="whisper-local" # whisper-local | web-speech | openai-whisper

# --- Mathematical Engine ---
ENABLE_SYMPY_VERIFICATION=True
